{
  "name": "steal-a-monster",
  "version": "0.1.0",
  "private": true,
  "description": "STEAL A MONSTER - a 3D multiplayer browser game: explore, battle and recruit adorable baby monsters, build your base and protect it from thieves.",
  "type": "module",
  "main": "server.js",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
